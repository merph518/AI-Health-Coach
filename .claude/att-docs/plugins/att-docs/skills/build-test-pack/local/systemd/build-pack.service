# Runs the test pack queue on the local model, one job at a time, until the
# queue is empty or the cutoff passes. The timer starts it each night.
#
# Install as a user unit:
#   cp build-pack.service build-pack.timer ~/.config/systemd/user/
#   mkdir -p ~/.config/build-pack
#   printf 'BUILD_PACK_SCRIPT=%s\nBUILD_PACK_CONFIG=%s\n' <path to build-pack.mjs> <path to pipeline.json> \
#     > ~/.config/build-pack/env
#   systemctl --user daemon-reload && systemctl --user enable --now build-pack.timer
#
# The journal holds the status lines and the morning summary, which carry no
# content: job IDs, phases, reason codes, counts and timings.

[Unit]
Description=Build queued test packs on the local model

[Service]
Type=oneshot
EnvironmentFile=%h/.config/build-pack/env
ExecStart=/usr/bin/node ${BUILD_PACK_SCRIPT} queue run --config ${BUILD_PACK_CONFIG}
Nice=10
