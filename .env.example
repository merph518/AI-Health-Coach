# SQLite database file (default: data/app.db)
DATABASE_PATH=data/app.db

# Public base URL; Google redirects back to $APP_URL/auth/google/callback
APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud console > APIs & Services > Credentials,
# "OAuth client ID", type "Web application"). Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Coach chat (Anthropic Console > API keys). Set a monthly spend limit there.
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-sonnet-5-5

# Web push for check-ins. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services; defaults to APP_URL. Must be https:// or mailto:
VAPID_SUBJECT=
